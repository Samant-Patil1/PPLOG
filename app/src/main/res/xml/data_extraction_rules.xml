<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; the rules here are for the standard backup/restore.
   Modify as needed for PPLOG's data handling.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep all shared preferences and database backups disabled until cloud backup is vetted -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
